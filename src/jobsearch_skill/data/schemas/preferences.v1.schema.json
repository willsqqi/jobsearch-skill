{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jobsearch-skill/schemas/preferences.v1.schema.json",
  "title": "Workflow preferences v1",
  "$defs": {
    "portable_ref": {"type": "string", "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"},
    "absolute_root": {"type": "string", "pattern": "^/[^\\u0000-\\u001F\\u007F]+$"},
    "root_ref": {"anyOf": [{"$ref": "#/$defs/portable_ref"}, {"$ref": "#/$defs/absolute_root"}]},
    "tex_ref": {"type": "string", "pattern": "^(?:[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?\\.tex$"},
    "pdf_ref": {"type": "string", "pattern": "^(?:[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?\\.pdf$"},
    "png_ref": {"type": "string", "pattern": "^(?:[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?\\.png$"}
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "default_cv": {"type": "string", "minLength": 1},
    "cvs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "root": {"$ref": "#/$defs/root_ref"},
          "tex": {"$ref": "#/$defs/tex_ref"},
          "pdf": {"$ref": "#/$defs/pdf_ref"},
          "assets": {"type": "array", "items": {"$ref": "#/$defs/png_ref"}, "uniqueItems": true}
        },
        "required": ["name", "root", "assets"],
        "anyOf": [{"required": ["tex"]}, {"required": ["pdf"]}],
        "additionalProperties": false
      }
    },
    "browser": {"const": "builtin"},
    "platform_priority": {"type": "array", "items": {"enum": ["workday"]}, "minItems": 1, "uniqueItems": true},
    "submission_mode": {"const": "manual"},
    "generated_artifacts": {
      "type": "object",
      "properties": {
        "naming_template": {"type": "string", "minLength": 1},
        "retain_days": {"type": "integer", "minimum": 0},
        "retain_failed_builds": {"type": "boolean"},
        "retain_build_logs": {"type": "boolean"}
      },
      "required": ["naming_template", "retain_days", "retain_failed_builds", "retain_build_logs"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "default_cv", "cvs", "browser", "platform_priority", "submission_mode", "generated_artifacts"],
  "additionalProperties": false
}
