{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jobsearch-skill/schemas/cv-evidence.v1.schema.json",
  "title": "Private extracted CV evidence v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "cv_name": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["source_ref", "sha256"],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "kind": {"enum": ["tex", "pdf"]},
          "text": {"type": "string", "minLength": 1}
        },
        "required": ["source_ref", "kind", "text"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["schema_version", "run_id", "cv_name", "source_hash", "source_hashes", "sources", "created_at"],
  "additionalProperties": false
}
