{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jobsearch-skill/schemas/reviewed-answers.v1.schema.json",
  "title": "Final reviewed form answers v1",
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "wording": {"type": "string", "minLength": 1},
        "value": {"oneOf": [{"type": "boolean"}, {"type": "string"}, {"type": "number"}, {"type": "array", "items": {"type": "string"}}]},
        "answer_type": {"enum": ["boolean", "string", "selection", "multi_selection", "number", "date", "free_text"]},
        "scope": {
          "type": "object",
          "properties": {"kind": {"enum": ["global", "company", "role", "job"]}, "company": {"type": "string"}, "role": {"type": "string"}, "job_fingerprint": {"type": "string"}},
          "required": ["kind"],
          "additionalProperties": false
        },
        "qualifiers": {
          "type": "object",
          "properties": {"negated": {"type": "boolean"}, "jurisdiction": {"type": "string"}, "time_period": {"type": "string"}, "unit": {"type": "string"}},
          "required": ["negated"],
          "additionalProperties": false
        },
        "topic_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "role_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source": {"enum": ["profile", "user", "codex_reviewed", "imported"]},
        "canonical_source_id": {"type": ["string", "null"]},
        "reviewed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["wording", "value", "answer_type", "scope", "qualifiers", "topic_tags", "role_tags", "source", "canonical_source_id", "reviewed_at"],
      "allOf": [
        {"if": {"properties": {"answer_type": {"const": "boolean"}}}, "then": {"properties": {"value": {"type": "boolean"}}}},
        {"if": {"properties": {"answer_type": {"enum": ["string", "selection", "date", "free_text"]}}}, "then": {"properties": {"value": {"type": "string"}}}},
        {"if": {"properties": {"answer_type": {"const": "multi_selection"}}}, "then": {"properties": {"value": {"type": "array", "items": {"type": "string"}}}}},
        {"if": {"properties": {"answer_type": {"const": "number"}}}, "then": {"properties": {"value": {"type": "number"}}}}
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "page_id": {"type": "string"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "required": ["schema_version", "run_id", "page_id", "entries"],
  "additionalProperties": false
}
